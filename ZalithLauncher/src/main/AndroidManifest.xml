<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature
        android:name="android.hardware.type.pc"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"/>
    <!--
      皮肤/资源插件是「独立 APK」，装到手机上就是一个应用。
      Android 11 起默认看不到别的应用，所以这里要声明才能把已安装的插件找出来
      （见 ZlPluginManager.scanInstalled）。本应用是侧载分发，不涉及商店审核。
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".ZLApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${launcher_name}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme.ZalithLauncher"
        android:appCategory="game"
        android:supportsRtl="true"
        android:isGame="true"
        android:allowBackup="true"
        android:hasFragileUserData="true"
        android:resizeableActivity="true"
        android:usesCleartextTraffic="true"
        android:preserveLegacyExternalStorage="true"
        android:requestLegacyExternalStorage="true"
        android:allowNativeHeapPointerTagging="false"
        tools:targetApi="33"
        tools:ignore="DiscouragedApi">
        <activity
            android:name=".ui.activities.SplashActivity"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme.SplashScreen"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 分享 / 「用其它应用打开」的入口。
             现在拆成四条：整合包 / 模组 / 布局 各一条明确的入口，再加一条 auto 通配兜底。
             独立入口的 intent-filter 收窄到对应扩展名，避免分享面板里并排出现同名条目。 -->
        <activity-alias
            android:label="@string/import_modpack"
            android:name="com.zalith.pcl.activity.ImportModpackActivity"
            android:exported="true"
            android:targetActivity=".ui.activities.SplashActivity">
            <meta-data
                android:name="import_type"
                android:value="modpack" />
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT"/>
                <action android:name="android.intent.action.VIEW"/>
                <data android:scheme="content"/>
                <data android:mimeType="application/zip"/>
                <data android:mimeType="application/x-rar-compressed"/>
                <data android:mimeType="application/x-7z-compressed"/>
            </intent-filter>
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT"/>
                <action android:name="android.intent.action.SEND"/>
                <data android:mimeType="application/zip"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:label="@string/import_mod"
            android:name="com.zalith.pcl.activity.ImportModActivity"
            android:exported="true"
            android:targetActivity=".ui.activities.SplashActivity">
            <meta-data
                android:name="import_type"
                android:value="mods" />
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT"/>
                <action android:name="android.intent.action.VIEW"/>
                <data android:scheme="content"/>
                <data android:mimeType="application/java-archive"/>
            </intent-filter>
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT"/>
                <action android:name="android.intent.action.SEND"/>
                <data android:mimeType="application/java-archive"/>
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:label="@string/import_layout"
            android:name="com.zalith.pcl.activity.ImportLayoutActivity"
            android:exported="true"
            android:targetActivity=".ui.activities.SplashActivity">
            <meta-data
                android:name="import_type"
                android:value="controls" />
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT"/>
                <action android:name="android.intent.action.VIEW"/>
                <data android:scheme="content"/>
                <data android:mimeType="application/json"/>
            </intent-filter>
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT"/>
                <action android:name="android.intent.action.SEND"/>
                <data android:mimeType="application/json"/>
            </intent-filter>
        </activity-alias>

        <!-- 分享 / 「用其它应用打开」只保留一个入口。
             以前这里是三个 activity-alias（导入整合包 / 导入控制布局 / 导入到启动器），
             分享一个文件时分享面板会并排出现三条同名启动器条目，用户根本不知道点哪个。
             现在合并成一条：具体是整合包还是键位布局，交给界面层按文件名后缀判断
             （json → 布局，zip / mrpack / 其它 → 整合包）。
             过滤器取并集，保证文件管理器「打开方式」和各类分享都还能命中。 -->
        <activity-alias
            android:label="@string/import_modpack"
            android:name="com.zalith.pcl.activity.ImportAnythingActivity"
            android:exported="true"
            android:targetActivity=".ui.activities.SplashActivity">

            <meta-data
                android:name="import_type"
                android:value="auto" />

            <!-- 文件管理器「用其它应用打开」：压缩包 / 整合包 -->
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT"/>
                <action android:name="android.intent.action.VIEW"/>
                <data android:scheme="file"/>
                <data android:scheme="content"/>
                <data android:mimeType="application/*"/>
            </intent-filter>
            <!-- 同上，但很多文件管理器把 .json 报成 text/plain -->
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT"/>
                <action android:name="android.intent.action.VIEW"/>
                <data android:scheme="file"/>
                <data android:scheme="content"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- 分享：必须声明 */* 才能被 type=*/* 的应用（含本应用自己的分享）匹配到 -->
            <intent-filter>
                <category android:name="android.intent.category.DEFAULT"/>
                <action android:name="android.intent.action.SEND"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.activities.MainActivity"
            android:launchMode="singleTop"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:screenOrientation="sensorLandscape" />

        <!--
            PCL2 界面移植版（项目名 Zalith-Plain Craft Launcher）：与原生 Material 界面并存，但不单独占桌面图标。
            桌面只保留 SplashActivity 一个入口，由它按「使用 PCL2 风格界面作为主界面」
            决定落在哪一边；本界面既可以从启动器内部直接 startActivity 进入
            （原生界面「设置 → 启动器 → 切换到 PCL2 界面」），也可以由 Splash 引导进来。
            横屏（与 PCL2 桌面窗口 850×500 的比例最接近）。
        -->
        <activity
            android:name=".ui.activities.Pcl2Activity"
            android:label="${launcher_name}"
            android:launchMode="singleTop"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode|density"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".ui.activities.ControlEditorActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:screenOrientation="sensorLandscape" />
        <activity
            android:name=".ui.activities.VMActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:process=":game"
            android:launchMode="standard"
            android:screenOrientation="sensorLandscape" />
        <activity android:name=".ui.activities.ErrorActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation"
            android:screenOrientation="sensorLandscape" />
        <activity android:name=".ui.activities.FatalErrorActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|keyboard|navigation"
            android:theme="@style/Theme.Material3.DayNight.Dialog.Alert" />

        <activity
            android:name=".filemanager.ui.FileManagerActivity"
            android:process=":filemanager"
            android:taskAffinity=":filemanager"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="sensorLandscape"
            android:enableOnBackInvokedCallback="true"
            android:exported="false" />

        <service
            android:name=".filemanager.events.FileManagerEventService"
            android:process=":filemanager"
            android:exported="false">
            <intent-filter>
                <action android:name="com.zalith.pcl.filemanager.EVENT_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name=".keepalive.TaskKeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_TYPE"
                android:value="Keep the launcher process alive while background tasks such as downloads and installations are running" />
        </service>

        <service
            android:name=".game.download.jvm_server.JvmService"
            android:enabled="true"
            android:foregroundServiceType="specialUse"
            android:process=":jvm">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_TYPE"
                android:value="Run Java Virtual Machine for game or server tasks" />
        </service>

        <service
            android:name=".game.launch.GameService"
            android:enabled="true"
            android:foregroundServiceType="specialUse"
            android:process=":game">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_TYPE"
                android:value="Running the game engine and maintaining game process" />
        </service>

        <service
            android:name=".terracotta.TerracottaVPNService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true"
            android:process=":game"
            android:foregroundServiceType="specialUse"
            tools:ignore="VpnServicePolicy">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_TYPE"
                android:value="Establish VPN tunnel for the multiplayer feature" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider
            android:name=".provider.FolderProvider"
            android:authorities="${packageName}.document.provider"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${packageName}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>
    <queries>
        <package android:name="net.kdt.pojavlaunch.ffmpeg"/>
        <package android:name="com.fcl.plugin.mobileglues"/>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>